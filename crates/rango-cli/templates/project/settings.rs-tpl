//! Settings for {{ project_name }} project.
//!
//! Every setting not listed keeps Rango's default; see `rango::conf::Settings` for the full list.

use std::collections::BTreeMap;

use rango::conf::{DatabaseConfig, Settings};

pub fn settings() -> Settings {
    Settings {
        // SECURITY WARNING: keep the secret key used in production secret!
        secret_key: "{{ secret_key }}".into(),
        // SECURITY WARNING: don't run with debug turned on in production!
        debug: true,
        allowed_hosts: vec![],

        // Application definition (apps register themselves with `register_app!`).
        installed_apps: vec![],
        middleware: [
            "rango.middleware.cors.CorsMiddleware",
            "rango.middleware.security.SecurityMiddleware",
            "rango.middleware.common.CommonMiddleware",
            "rango.middleware.csrf.CsrfViewMiddleware",
            "rango.middleware.clickjacking.XFrameOptionsMiddleware",
        ]
        .map(String::from)
        .to_vec(),
        root_urlconf: Some("{{ project_name }}.urls".into()),

        templates: vec![rango::json!({
            "BACKEND": "rango.template.backends.rango.RangoTemplates",
            "DIRS": ["templates"],
            "APP_DIRS": true,
            "OPTIONS": {
                "context_processors": [
                    "rango.template.context_processors.debug",
                    "rango.template.context_processors.request",
                ],
            },
        })],

        databases: BTreeMap::from([(
            "default".to_owned(),
            DatabaseConfig {
                engine: "rango.db.backends.sqlite3".into(),
                name: "db.sqlite3".into(),
                ..DatabaseConfig::default()
            },
        )]),

        language_code: "en-us".into(),
        time_zone: "UTC".into(),
        use_i18n: true,
        use_tz: true,

        static_url: Some("static/".into()),

        // CORS: no cross-origin access until an origin is listed.
        cors_allowed_origins: vec![],

        // REST framework and the OpenAPI document.
        rest_framework: rango::json!({}),
        spectacular_settings: rango::json!({ "TITLE": "{{ project_name }} API", "VERSION": "0.1.0" }),
        ..Settings::default()
    }
}
